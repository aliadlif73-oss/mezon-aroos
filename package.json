{
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "PORT=3000 node dev.mjs",
    "start": "node dev.mjs",
    "lint": "for f in dev.mjs scripts/*.mjs worker/*.js; do node --check \"$f\" || exit 1; done",
    "test": "node --test tests/*.test.mjs",
    "build": "bash scripts/build.sh",
    "check:kie": "node scripts/provider-check.mjs",
    "deploy": "npx --yes wrangler@4 deploy"
  }
}
